NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Contrato explícito: development, test, preview ou production.
APP_ENV=development
# Integrações externas ficam desativadas por padrão. Em preview/teste: disabled ou sandbox.
EXTERNAL_INTEGRATIONS_MODE=disabled
# Apenas para um projeto Supabase remoto descartável e isolado; nunca use o ref de produção.
TEST_SUPABASE_PROJECT_REF=
# Nunca prefixar segredos de servidor com NEXT_PUBLIC_.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
CRON_SECRET=
# Chave exclusiva do servidor; nunca use o prefixo NEXT_PUBLIC_.
RESEND_API_KEY=re_sua_chave_resend
# Opcional. Em teste, o app usa FLERNK <onboarding@resend.dev>.
# Em produção, use um domínio verificado na Resend.
RESEND_FROM_EMAIL=FLERNK <convites@seu-dominio.com>
